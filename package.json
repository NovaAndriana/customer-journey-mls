{
  "name": "customer-journey-mls",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green npm:dev:api npm:dev:web",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build": "pnpm build:api && pnpm build:web"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
